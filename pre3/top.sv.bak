// 1. Top Module
module top(
    input  logic        clk, reset,
    output logic [31:0] WriteData, DataAdr,
    output logic        MemWrite
);

    logic [31:0] ReadData;

    // Instantiate processor and shared memory
    riscv rv(clk, reset, ReadData, MemWrite, DataAdr, WriteData);
    mem   memory(clk, MemWrite, DataAdr, WriteData, ReadData);

endmodule

// 2. Unified Memory Module
module mem(
    input  logic        clk, we,
    input  logic [31:0] a, wd,
    output logic [31:0] rd
);

    logic [31:0] RAM[63:0]; // 64-word memory

    // Load test program
    initial $readmemh("memfile.txt", RAM); // [cite: 20]

    assign rd = RAM[a[31:2]]; // Word-aligned read

    always_ff @(posedge clk)
        if (we) RAM[a[31:2]] <= wd; // Word-aligned write

endmodule